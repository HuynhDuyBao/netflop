{
  "name": "netflop",
  "version": "1.0.0",
  "private": true,
  "description": "Netflop movie application with React frontend and Node.js Express backend.",
  "scripts": {
    "backend": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "start": "npm run backend:start"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=18"
  }
}
